# Copy to /etc/deadman/<name>.env. One per host is usually enough.

# The switch to ping. Any service with a "ping this URL or I will tell you"
# model works; the failure endpoint is this URL with /fail appended, which is
# what healthchecks.io and its self-hosted equivalents expect.
#
# THIS MUST NOT LIVE ON THE HOST IT WATCHES. The whole point is that the
# absence of a ping is the alarm, so the thing waiting for the ping has to
# survive this machine, its network and its power.
DEADMAN_PING_URL=https://hc-ping.example.com/your-uuid-here

DEADMAN_CHECKS_DIR=/etc/deadman/checks.d
DEADMAN_STATE_DIR=/var/lib/deadman
DEADMAN_CURL_TIMEOUT=10
